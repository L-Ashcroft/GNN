  "weight_decay": 0.01,
  "epochs": 6,
  "patience": 2,
  "checkpoint_every_batches": 250,
  "device": "cuda",
  "test_policy": "Evaluate once after validation-selected training; no test data for model selection",
  "precision": "FP32; train-only symlog calibration",
  "contract_residual": false,
  "calibrated_targets": true,
  "adapter_hidden": 32,
  "adapter_min_train_samples": 256,
  "target_calibration": "data/model_ready/fusion_v2_accuracy_v2/target_calibration.json",
  "head_batch_size": 1024,
  "stage": "frozen_all_embedding_parameters_train_head"
}