{
  "dataset": "data/fusion_v2",
  "split": "data/fusion_v2/splits/id_stratified_v1.parquet",
  "cache": "data/model_ready/fusion_v2_training_v1",
  "output": "artifacts/experiment1_accuracy_v2_cached_head",
  "hidden_dim": 128,
  "num_layers": 4,
  "dropout": 0.1,
